# CampusWatch backend configuration.
#
# Copy this file to backend/.env and fill in real values:
#
#     cp backend/.env.example backend/.env
#
# backend/.env is ignored by git. Nothing here is a real credential — this
# template is the tracked file, and the one with the actual connection string
# must never be committed.
#
# config.loadDotEnv reads backend/.env first and falls back to .env in the
# repository root, so either location works. An already-set environment variable
# always wins, which is what a deployment should use.

# Port the HTTP server listens on. It serves the API and the dashboard together,
# so this is the only port the deployment needs.
PORT=8080

# PostgreSQL connection string. CampusWatch applies its migrations on startup,
# so the database must exist and the user must be allowed to create tables.
#
# A hosted instance (Neon, RDS, Supabase) looks like:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require
#
# A local PostgreSQL looks like:
#   DATABASE_URL=postgres://campuswatch:campuswatch@localhost:5432/campuswatch?sslmode=disable
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional. Where the server finds the dashboard, when it is not beside the
# binary. Defaults to frontend/ or ../frontend from the working directory.
# FRONTEND_DIR=/srv/campuswatch/frontend

# Optional. Where the server finds the SQL migrations. Defaults to
# backend/migrations or migrations from the working directory.
# MIGRATIONS_DIR=/srv/campuswatch/backend/migrations
